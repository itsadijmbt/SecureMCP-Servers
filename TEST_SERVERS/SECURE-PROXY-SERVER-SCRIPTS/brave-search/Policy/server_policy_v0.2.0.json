      },
      "tool:brave-search-proxy/brave_video_search": {
        "query": {
          "type": "string",
          "min_length": 1,
          "max_length": 400,
          "pattern": "^(?!.*[A-Za-z0-9+/=]{41,}).*$"
        },
        "count": {
          "type": "integer",
          "min": 1,
          "max": 50
        },
        "offset": {
          "type": "integer",
