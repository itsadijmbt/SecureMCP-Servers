{
  "policy_id": "app:brave-search-proxy",
  "version": "0.2.0",
  "scope": "global",
  "resources": [
    "tool:brave-search-proxy/brave_web_search",
    "tool:brave-search-proxy/brave_local_search",
    "tool:brave-search-proxy/brave_video_search",
    "tool:brave-search-proxy/brave_image_search",
    "tool:brave-search-proxy/brave_news_search",
    "tool:brave-search-proxy/brave_summarizer",
    "tool:brave-search-proxy/brave_place_search"
  ],
  "denied_resources": [
    "tool:brave-search-proxy/brave_llm_context"
  ],
  "constraints": {
    "denied_parameters": {
      "tool:brave-search-proxy/brave_web_search": {
        "query": [
          "*-----BEGIN*PRIVATE KEY*"
        ]
      },
      "tool:brave-search-proxy/brave_local_search": {
        "query": [
          "*-----BEGIN*PRIVATE KEY*"
        ]
      },
      "tool:brave-search-proxy/brave_news_search": {
        "query": [
          "*-----BEGIN*PRIVATE KEY*"
        ]
      },
      "tool:brave-search-proxy/brave_video_search": {
        "query": [
          "*-----BEGIN*PRIVATE KEY*"
        ]
      },
      "tool:brave-search-proxy/brave_image_search": {
        "query": [
          "*-----BEGIN*PRIVATE KEY*"
        ]
      },
      "tool:brave-search-proxy/brave_place_search": {
        "query": [
          "*-----BEGIN*PRIVATE KEY*"
        ]
      }
    },
    "parameters": {
      "tool:brave-search-proxy/brave_web_search": {
        "query": {
          "type": "string",
          "min_length": 1,
          "max_length": 400,
          "pattern": "^(?!.*[A-Za-z0-9+/=]{41,}).*$"
        },
        "count": {
          "type": "integer",
          "min": 1,
          "max": 20
        },
        "offset": {
          "type": "integer",
          "min": 0,
          "max": 9
        },
        "safesearch": {
          "type": "string",
          "allowed_values": [
            "moderate",
            "strict"
          ]
        },
        "freshness": {
          "type": "string",
          "allowed_values": [
            "pd",
            "pw",
            "pm",
            "py"
          ]
        },
        "result_filter": {
          "type": "array",
          "min_items": 1,
          "max_items": 10
        },
        "units": {
          "type": "string",
          "allowed_values": [
            "metric",
            "imperial"
          ]
        },
        "goggles": {
          "type": "string",
          "max_length": 0
        }
      },
      "tool:brave-search-proxy/brave_local_search": {
        "query": {
          "type": "string",
          "min_length": 1,
          "max_length": 400,
          "pattern": "^(?!.*[A-Za-z0-9+/=]{41,}).*$"
        },
        "count": {
          "type": "integer",
          "min": 1,
          "max": 20
        },
        "offset": {
          "type": "integer",
          "min": 0,
          "max": 9
        },
        "safesearch": {
          "type": "string",
          "allowed_values": [
            "moderate",
            "strict"
          ]
        },
        "goggles": {
          "type": "string",
          "max_length": 0
        }
      },
      "tool:brave-search-proxy/brave_news_search": {
        "query": {
          "type": "string",
          "min_length": 1,
          "max_length": 400,
          "pattern": "^(?!.*[A-Za-z0-9+/=]{41,}).*$"
        },
        "count": {
          "type": "integer",
          "min": 1,
          "max": 50
        },
        "offset": {
          "type": "integer",
          "min": 0,
          "max": 9
