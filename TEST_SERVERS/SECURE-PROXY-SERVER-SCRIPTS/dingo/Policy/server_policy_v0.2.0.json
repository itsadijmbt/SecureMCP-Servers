{
  "policy_id": "app:dingo-proxy",
  "version": "0.2.0",
  "scope": "global",
  "resources": [
    "tool:dingo-proxy/list_dingo_components",
    "tool:dingo-proxy/get_rule_details",
    "tool:dingo-proxy/get_llm_details",
    "tool:dingo-proxy/get_prompt_details",
    "tool:dingo-proxy/run_quick_evaluation"
  ],
  "denied_resources": [
    "tool:dingo-proxy/run_dingo_evaluation"
  ],
  "constraints": {
    "parameters": {
      "tool:dingo-proxy/list_dingo_components": {
        "component_type": {
          "type": "string",
          "allowed_values": [
            "rule_groups",
            "llm_models",
            "prompts",
            "all"
          ]
        },
        "include_details": {
          "type": "boolean"
        }
      },
      "tool:dingo-proxy/get_rule_details": {
        "rule_name": {
          "type": "string",
          "min_length": 1,
          "max_length": 256
        }
      },
      "tool:dingo-proxy/get_llm_details": {
        "llm_name": {
          "type": "string",
          "min_length": 1,
          "max_length": 256
        }
      },
      "tool:dingo-proxy/get_prompt_details": {
        "llm_name": {
          "type": "string",
          "min_length": 1,
          "max_length": 256
        }
      },
      "tool:dingo-proxy/run_quick_evaluation": {
        "input_path": {
          "type": "string",
          "min_length": 1,
          "max_length": 4096
        },
        "evaluation_goal": {
          "type": "string",
          "min_length": 1,
          "max_length": 2000
        }
      }
    },
    "denied_parameters": {
      "tool:dingo-proxy/run_quick_evaluation": {
        "input_path": [
          "*..*"
        ]
      }
    }
  },
  "description": "Dingo protected by Secure MCP proxy"
}
