{
  "policy_id": "app:atlassian-proxy",
  "version": "0.2.0",
  "scope": "global",
  "description": "Atlassian Rovo MCP v2 via SecureMCPProxy: Jira and Confluence; reads via executeRead; no deferred writes or deletes",
  "resources": [
    "tool:atlassian-proxy/atlassianUserInfo",
    "tool:atlassian-proxy/getAccessibleAtlassianResources",
    "tool:atlassian-proxy/discover",
    "tool:atlassian-proxy/executeRead",
    "tool:atlassian-proxy/getJiraIssue",
    "tool:atlassian-proxy/searchJiraIssuesUsingJql",
    "tool:atlassian-proxy/getConfluenceContent",
    "tool:atlassian-proxy/searchConfluence",
    "tool:atlassian-proxy/search",
    "tool:atlassian-proxy/getTeamworkGraphContext",
    "tool:atlassian-proxy/getTeamworkGraphObject",
    "tool:atlassian-proxy/getLoomObjectsContent",
    "tool:atlassian-proxy/createJiraIssue",
    "tool:atlassian-proxy/editJiraIssue",
    "tool:atlassian-proxy/transitionJiraIssue",
    "tool:atlassian-proxy/addOrEditJiraIssueComment",
    "tool:atlassian-proxy/createConfluenceContent",
    "tool:atlassian-proxy/updateConfluenceContent"
  ],
  "denied_resources": [
    "tool:atlassian-proxy/executeWrite",
    "tool:atlassian-proxy/executeDestructive",
    "tool:atlassian-proxy/getPeopleInfo",
    "tool:atlassian-proxy/getWorkPortfolio",
    "tool:atlassian-proxy/getWorkActivity",
    "tool:atlassian-proxy/getCollaborators",
    "tool:atlassian-proxy/addTeamworkGraphContext",
    "tool:atlassian-proxy/enableConfluencePublicLink",
    "tool:atlassian-proxy/addConfluenceContentPermissions",
    "tool:atlassian-proxy/replaceConfluenceContentPermissions",
    "tool:atlassian-proxy/setConfluenceContentRestrictionState",
    "tool:atlassian-proxy/setConfluenceSpaceInstructions",
    "tool:atlassian-proxy/createBitbucketRepoCommit",
    "tool:atlassian-proxy/mergeBitbucketRepoPullRequest",
    "tool:atlassian-proxy/runBitbucketRepoPipeline",
    "tool:atlassian-proxy/deleteJiraIssue"
  ]
}
