{
  "policy_id": "app:supabase-proxy",
  "version": "0.1.0",
  "scope": "global",
  "resources": [
    "tool:supabase-proxy/**"
  ],
  "denied_resources": [
    "tool:supabase-proxy/execute_sql",
    "tool:supabase-proxy/apply_migration",
    "tool:supabase-proxy/deploy_edge_function",
    "tool:supabase-proxy/create_project",
    "tool:supabase-proxy/create_branch",
    "tool:supabase-proxy/delete_branch",
    "tool:supabase-proxy/merge_branch",
    "tool:supabase-proxy/rebase_branch",
    "tool:supabase-proxy/reset_branch",
    "tool:supabase-proxy/pause_project",
    "tool:supabase-proxy/restore_project",
    "tool:supabase-proxy/confirm_cost",
    "tool:supabase-proxy/get_publishable_keys"
  ],
  "constraints": {
    "denied_parameters": {
      "tool:supabase-proxy/search_docs": {
        "graphql_query": [
          "*DENYME*"
        ]
      }
    },
    "parameters": {
      "tool:supabase-proxy/generate_typescript_types": {
        "project_id": {"type": "string", "min_length": 16, "max_length": 32, "pattern": "^[a-z0-9]{16,32}$"}
      },
      "tool:supabase-proxy/get_advisors": {
        "project_id": {"type": "string", "min_length": 16, "max_length": 32, "pattern": "^[a-z0-9]{16,32}$"},
        "type": {"type": "string", "allowed_values": ["security", "performance"]}
      },
      "tool:supabase-proxy/get_cost": {
        "type": {"type": "string", "allowed_values": ["project", "branch"]},
        "organization_id": {"type": "string", "min_length": 16, "max_length": 32, "pattern": "^[a-z0-9]{16,32}$"}
      },
      "tool:supabase-proxy/get_edge_function": {
        "project_id": {"type": "string", "min_length": 16, "max_length": 32, "pattern": "^[a-z0-9]{16,32}$"},
        "function_slug": {"type": "string", "min_length": 1, "max_length": 64, "pattern": "^[A-Za-z0-9_-]+$"}
      },
      "tool:supabase-proxy/get_logs": {
        "project_id": {"type": "string", "min_length": 16, "max_length": 32, "pattern": "^[a-z0-9]{16,32}$"},
        "service": {"type": "string", "allowed_values": ["api", "branch-action", "postgres", "edge-function", "auth", "storage", "realtime"]}
      },
      "tool:supabase-proxy/get_organization": {
        "id": {"type": "string", "min_length": 16, "max_length": 32, "pattern": "^[a-z0-9]{16,32}$"}
      },
      "tool:supabase-proxy/get_project": {
        "id": {"type": "string", "min_length": 16, "max_length": 32, "pattern": "^[a-z0-9]{16,32}$"}
      },
      "tool:supabase-proxy/get_project_url": {
        "project_id": {"type": "string", "min_length": 16, "max_length": 32, "pattern": "^[a-z0-9]{16,32}$"}
      },
      "tool:supabase-proxy/list_branches": {
        "project_id": {"type": "string", "min_length": 16, "max_length": 32, "pattern": "^[a-z0-9]{16,32}$"}
      },
      "tool:supabase-proxy/list_edge_functions": {
        "project_id": {"type": "string", "min_length": 16, "max_length": 32, "pattern": "^[a-z0-9]{16,32}$"}
      },
      "tool:supabase-proxy/list_extensions": {
        "project_id": {"type": "string", "min_length": 16, "max_length": 32, "pattern": "^[a-z0-9]{16,32}$"}
      },
      "tool:supabase-proxy/list_migrations": {
        "project_id": {"type": "string", "min_length": 16, "max_length": 32, "pattern": "^[a-z0-9]{16,32}$"}
      },
      "tool:supabase-proxy/list_tables": {
        "project_id": {"type": "string", "min_length": 16, "max_length": 32, "pattern": "^[a-z0-9]{16,32}$"},
        "schemas": {"type": "array", "min_items": 1, "max_items": 10}
      },
      "tool:supabase-proxy/search_docs": {
        "graphql_query": {"type": "string", "min_length": 1, "max_length": 2000}
      }
    }
  },
  "description": "Supabase MCP via SecureMCPProxy -- raw SQL, migrations, edge-function deployment, project/branch lifecycle and publishable-key disclosure denied; project refs pattern-bound and read surface enum- and size-capped."
}
