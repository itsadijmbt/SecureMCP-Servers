{
  "policy_id": "app:supabase-proxy",
  "version": "0.2.0",
  "scope": "global",
  "resources": [
    "tool:supabase-proxy/search_docs",
    "tool:supabase-proxy/execute_sql",
    "tool:supabase-proxy/list_organizations",
    "tool:supabase-proxy/get_organization",
    "tool:supabase-proxy/list_projects",
    "tool:supabase-proxy/get_project",
    "tool:supabase-proxy/get_project_url",
    "tool:supabase-proxy/get_cost",
    "tool:supabase-proxy/list_tables",
    "tool:supabase-proxy/list_extensions",
    "tool:supabase-proxy/list_migrations",
    "tool:supabase-proxy/query_logs",
    "tool:supabase-proxy/get_advisors",
    "tool:supabase-proxy/generate_typescript_types",
    "tool:supabase-proxy/list_edge_functions",
    "tool:supabase-proxy/get_edge_function",
    "tool:supabase-proxy/list_branches"
  ],
  "denied_resources": [
    "tool:supabase-proxy/get_publishable_keys",
    "tool:supabase-proxy/confirm_cost",
    "tool:supabase-proxy/apply_migration",
    "tool:supabase-proxy/deploy_edge_function",
    "tool:supabase-proxy/create_project",
    "tool:supabase-proxy/create_branch",
    "tool:supabase-proxy/delete_branch",
    "tool:supabase-proxy/merge_branch",
    "tool:supabase-proxy/rebase_branch",
    "tool:supabase-proxy/reset_branch",
    "tool:supabase-proxy/pause_project",
    "tool:supabase-proxy/restore_project"
  ],
  "constraints": {
    "parameters": {
      "tool:supabase-proxy/execute_sql": {
        "project_id": {
          "type": "string",
          "min_length": 16,
          "max_length": 32,
          "pattern": "^[a-z0-9]{16,32}$"
        },
        "query": {
          "type": "string",
          "min_length": 1,
          "max_length": 10000
        }
      },
      "tool:supabase-proxy/generate_typescript_types": {
        "project_id": {
          "type": "string",
          "min_length": 16,
          "max_length": 32,
          "pattern": "^[a-z0-9]{16,32}$"
        }
      },
      "tool:supabase-proxy/get_advisors": {
        "project_id": {
          "type": "string",
          "min_length": 16,
          "max_length": 32,
          "pattern": "^[a-z0-9]{16,32}$"
        },
        "type": {
          "type": "string",
          "allowed_values": [
            "security",
            "performance"
          ]
        }
      },
      "tool:supabase-proxy/get_cost": {
        "type": {
          "type": "string",
          "allowed_values": [
            "project",
            "branch"
          ]
        },
        "organization_id": {
          "type": "string",
          "min_length": 16,
          "max_length": 32,
          "pattern": "^[a-z0-9]{16,32}$"
        }
      },
      "tool:supabase-proxy/get_edge_function": {
        "project_id": {
          "type": "string",
          "min_length": 16,
          "max_length": 32,
          "pattern": "^[a-z0-9]{16,32}$"
        },
        "function_slug": {
          "type": "string",
          "min_length": 1,
          "max_length": 64,
          "pattern": "^[A-Za-z0-9_-]+$"
        }
      },
      "tool:supabase-proxy/query_logs": {
        "project_id": {
          "type": "string",
          "min_length": 16,
          "max_length": 32,
          "pattern": "^[a-z0-9]{16,32}$"
        },
        "sql": {
          "type": "string",
          "min_length": 1,
          "max_length": 4000
        }
      },
      "tool:supabase-proxy/get_organization": {
        "id": {
          "type": "string",
          "min_length": 16,
          "max_length": 32,
          "pattern": "^[a-z0-9]{16,32}$"
        }
      },
      "tool:supabase-proxy/get_project": {
        "id": {
          "type": "string",
          "min_length": 16,
          "max_length": 32,
          "pattern": "^[a-z0-9]{16,32}$"
        }
      },
      "tool:supabase-proxy/get_project_url": {
        "project_id": {
          "type": "string",
          "min_length": 16,
          "max_length": 32,
          "pattern": "^[a-z0-9]{16,32}$"
        }
      },
      "tool:supabase-proxy/list_branches": {
        "project_id": {
          "type": "string",
          "min_length": 16,
          "max_length": 32,
          "pattern": "^[a-z0-9]{16,32}$"
        }
      },
      "tool:supabase-proxy/list_edge_functions": {
        "project_id": {
          "type": "string",
          "min_length": 16,
          "max_length": 32,
          "pattern": "^[a-z0-9]{16,32}$"
        }
      },
      "tool:supabase-proxy/list_extensions": {
        "project_id": {
          "type": "string",
          "min_length": 16,
          "max_length": 32,
          "pattern": "^[a-z0-9]{16,32}$"
        }
      },
      "tool:supabase-proxy/list_migrations": {
        "project_id": {
          "type": "string",
          "min_length": 16,
          "max_length": 32,
          "pattern": "^[a-z0-9]{16,32}$"
        }
      },
      "tool:supabase-proxy/list_tables": {
        "project_id": {
          "type": "string",
          "min_length": 16,
          "max_length": 32,
          "pattern": "^[a-z0-9]{16,32}$"
        },
        "schemas": {
          "type": "array",
          "min_items": 1,
          "max_items": 10
        }
      },
      "tool:supabase-proxy/search_docs": {
        "graphql_query": {
          "type": "string",
          "min_length": 1,
          "max_length": 2000
        }
      }
    }
  },
  "description": "Supabase protected by Secure MCP proxy"
}
