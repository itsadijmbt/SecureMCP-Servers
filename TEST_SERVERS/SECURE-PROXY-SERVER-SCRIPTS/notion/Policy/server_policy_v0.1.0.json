{
  "policy_id": "app:notion-proxy",
  "version": "0.1.0",
  "scope": "global",
  "resources": [
    "tool:notion-proxy/**"
  ],
  "denied_resources": [
    "tool:notion-proxy/API-delete-a-block",
    "tool:notion-proxy/API-patch-page",
    "tool:notion-proxy/API-update-a-block",
    "tool:notion-proxy/API-update-a-data-source",
    "tool:notion-proxy/API-update-page-markdown",
    "tool:notion-proxy/API-post-page",
    "tool:notion-proxy/API-create-a-data-source",
    "tool:notion-proxy/API-create-a-comment",
    "tool:notion-proxy/API-move-page",
    "tool:notion-proxy/API-patch-block-children"
  ],
  "constraints": {
    "parameters": {
      "tool:notion-proxy/API-get-block-children": {
        "block_id": {
          "type": "string",
          "max_length": 36,
          "pattern": "^[0-9a-fA-F]{8}-?[0-9a-fA-F]{4}-?[0-9a-fA-F]{4}-?[0-9a-fA-F]{4}-?[0-9a-fA-F]{12}$"
        },
        "start_cursor": {
          "type": "string",
          "max_length": 256
        },
        "page_size": {
          "type": "integer",
          "min": 1,
          "max": 100
        }
      },
      "tool:notion-proxy/API-get-user": {
        "user_id": {
          "type": "string",
          "max_length": 36,
          "pattern": "^[0-9a-fA-F]{8}-?[0-9a-fA-F]{4}-?[0-9a-fA-F]{4}-?[0-9a-fA-F]{4}-?[0-9a-fA-F]{12}$"
        }
      },
      "tool:notion-proxy/API-get-users": {
        "start_cursor": {
          "type": "string",
          "max_length": 256
        },
        "page_size": {
          "type": "integer",
          "min": 1,
          "max": 100
        }
      },
      "tool:notion-proxy/API-list-data-source-templates": {
        "data_source_id": {
          "type": "string",
          "max_length": 36,
          "pattern": "^[0-9a-fA-F]{8}-?[0-9a-fA-F]{4}-?[0-9a-fA-F]{4}-?[0-9a-fA-F]{4}-?[0-9a-fA-F]{12}$"
        },
        "start_cursor": {
          "type": "string",
          "max_length": 256
        },
        "page_size": {
          "type": "integer",
          "min": 1,
          "max": 100
        }
      },
      "tool:notion-proxy/API-post-search": {
        "query": {
          "type": "string",
          "max_length": 256
        },
        "start_cursor": {
          "type": "string",
          "max_length": 256
        },
        "page_size": {
          "type": "integer",
          "min": 1,
          "max": 100
        }
      },
      "tool:notion-proxy/API-query-data-source": {
        "data_source_id": {
          "type": "string",
          "max_length": 36,
          "pattern": "^[0-9a-fA-F]{8}-?[0-9a-fA-F]{4}-?[0-9a-fA-F]{4}-?[0-9a-fA-F]{4}-?[0-9a-fA-F]{12}$"
        },
        "filter_properties": {
          "type": "array",
          "max_items": 50
        },
        "sorts": {
          "type": "array",
          "max_items": 10
        },
        "start_cursor": {
          "type": "string",
          "max_length": 256
        },
        "page_size": {
          "type": "integer",
          "min": 1,
          "max": 100
        }
      },
      "tool:notion-proxy/API-retrieve-a-block": {
        "block_id": {
          "type": "string",
          "max_length": 36,
          "pattern": "^[0-9a-fA-F]{8}-?[0-9a-fA-F]{4}-?[0-9a-fA-F]{4}-?[0-9a-fA-F]{4}-?[0-9a-fA-F]{12}$"
        }
      },
      "tool:notion-proxy/API-retrieve-a-comment": {
        "block_id": {
          "type": "string",
          "max_length": 36,
          "pattern": "^[0-9a-fA-F]{8}-?[0-9a-fA-F]{4}-?[0-9a-fA-F]{4}-?[0-9a-fA-F]{4}-?[0-9a-fA-F]{12}$"
        },
        "start_cursor": {
          "type": "string",
          "max_length": 256
        },
        "page_size": {
          "type": "integer",
          "min": 1,
          "max": 100
        }
      },
      "tool:notion-proxy/API-retrieve-a-data-source": {
        "data_source_id": {
          "type": "string",
          "max_length": 36,
          "pattern": "^[0-9a-fA-F]{8}-?[0-9a-fA-F]{4}-?[0-9a-fA-F]{4}-?[0-9a-fA-F]{4}-?[0-9a-fA-F]{12}$"
        }
      },
      "tool:notion-proxy/API-retrieve-a-database": {
        "database_id": {
          "type": "string",
          "max_length": 36,
          "pattern": "^[0-9a-fA-F]{8}-?[0-9a-fA-F]{4}-?[0-9a-fA-F]{4}-?[0-9a-fA-F]{4}-?[0-9a-fA-F]{12}$"
        }
      },
      "tool:notion-proxy/API-retrieve-a-page": {
        "page_id": {
          "type": "string",
          "max_length": 36,
          "pattern": "^[0-9a-fA-F]{8}-?[0-9a-fA-F]{4}-?[0-9a-fA-F]{4}-?[0-9a-fA-F]{4}-?[0-9a-fA-F]{12}$"
        },
        "filter_properties": {
          "type": "string",
          "max_length": 256
        }
      },
      "tool:notion-proxy/API-retrieve-a-page-property": {
        "page_id": {
          "type": "string",
          "max_length": 36,
          "pattern": "^[0-9a-fA-F]{8}-?[0-9a-fA-F]{4}-?[0-9a-fA-F]{4}-?[0-9a-fA-F]{4}-?[0-9a-fA-F]{12}$"
        },
        "property_id": {
          "type": "string",
          "min_length": 1,
          "max_length": 128,
          "pattern": "^[A-Za-z0-9%_~.-]+$"
        },
        "start_cursor": {
          "type": "string",
          "max_length": 256
        },
        "page_size": {
          "type": "integer",
          "min": 1,
          "max": 100
        }
      },
      "tool:notion-proxy/API-retrieve-page-markdown": {
        "page_id": {
          "type": "string",
          "max_length": 36,
          "pattern": "^[0-9a-fA-F]{8}-?[0-9a-fA-F]{4}-?[0-9a-fA-F]{4}-?[0-9a-fA-F]{4}-?[0-9a-fA-F]{12}$"
        }
      }
    }
  },
  "description": "Notion MCP via SecureMCPProxy -- all page/block/data-source mutation, deletion, archival and comment creation denied; read surface bound to UUID ids and 100-item pages."
}
