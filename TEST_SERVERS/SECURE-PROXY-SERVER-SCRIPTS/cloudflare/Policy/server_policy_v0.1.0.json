{
  "policy_id": "app:cloudflare-proxy",
  "version": "0.1.0",
  "scope": "global",
  "resources": [
    "tool:cloudflare-proxy/**"
  ],
  "denied_resources": [
    "tool:cloudflare-proxy/d1_database_query",
    "tool:cloudflare-proxy/d1_database_create",
    "tool:cloudflare-proxy/d1_database_delete",
    "tool:cloudflare-proxy/kv_namespace_create",
    "tool:cloudflare-proxy/kv_namespace_delete",
    "tool:cloudflare-proxy/kv_namespace_update",
    "tool:cloudflare-proxy/r2_bucket_create",
    "tool:cloudflare-proxy/r2_bucket_delete",
    "tool:cloudflare-proxy/hyperdrive_config_edit",
    "tool:cloudflare-proxy/hyperdrive_config_delete",
    "tool:cloudflare-proxy/hyperdrive_config_get",
    "tool:cloudflare-proxy/workers_get_worker_code"
  ],
  "constraints": {
    "parameters": {
      "tool:cloudflare-proxy/d1_database_get": {
        "database_id": {
          "type": "string",
          "min_length": 1,
          "max_length": 64,
          "pattern": "^[A-Za-z0-9-]+$"
        }
      },
      "tool:cloudflare-proxy/d1_databases_list": {
        "name": {
          "type": "string",
          "max_length": 128
        },
        "page": {
          "type": "number",
          "min": 1,
          "max": 1000
        },
        "per_page": {
          "type": "number",
          "min": 1,
          "max": 100
        }
      },
      "tool:cloudflare-proxy/hyperdrive_configs_list": {
        "page": {
          "type": "number",
          "min": 1,
          "max": 1000
        },
        "per_page": {
          "type": "number",
          "min": 1,
          "max": 100
        },
        "direction": {
          "type": "string",
          "allowed_values": [
            "asc",
            "desc"
          ]
        }
      },
      "tool:cloudflare-proxy/kv_namespace_get": {
        "namespace_id": {
          "type": "string",
          "min_length": 1,
          "max_length": 64,
          "pattern": "^[A-Za-z0-9]+$"
        }
      },
      "tool:cloudflare-proxy/r2_bucket_get": {
        "name": {
          "type": "string",
          "min_length": 1,
          "max_length": 64,
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        }
      },
      "tool:cloudflare-proxy/r2_buckets_list": {
        "name_contains": {
          "type": "string",
          "max_length": 64
        },
        "cursor": {
          "type": "string",
          "max_length": 256
        },
        "direction": {
          "type": "string",
          "allowed_values": [
            "asc",
            "desc"
          ]
        },
        "per_page": {
          "type": "number",
          "min": 1,
          "max": 100
        },
        "start_after": {
          "type": "string",
          "max_length": 64
        }
      },
      "tool:cloudflare-proxy/search_cloudflare_documentation": {
        "query": {
          "type": "string",
          "min_length": 1,
          "max_length": 512
        }
      },
      "tool:cloudflare-proxy/workers_get_worker": {
        "scriptName": {
          "type": "string",
          "min_length": 1,
          "max_length": 64,
          "pattern": "^[A-Za-z0-9_-]+$"
        }
      }
    }
  },
  "description": "Cloudflare Workers-bindings MCP via SecureMCPProxy -- arbitrary D1 SQL, all D1/KV/R2 create-delete, Hyperdrive config read-and-write and Worker source disclosure denied; ids pattern-bound and listings page-capped."
}
